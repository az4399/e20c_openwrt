{
	"luci-app-dae": {
		"description": "Grant access to the DAE LuCI application",
		"read": {
			"ubus": {
				"luci.dae": [ "getInitStatus" ]
			},
			"file": {
				"/etc/dae/config.dae": [ "read" ],
				"/var/log/dae.log": [ "read" ]
			},
			"uci": [ "dae" ]
		},
		"write": {
			"ubus": {
				"luci.dae": [ "setInitAction" ]
			},
			"file": {
				"/etc/dae/config.dae": [ "write" ],
				"/var/log/dae.log": [ "write" ]
			},
			"uci": [ "dae" ]
		}
	}
}
